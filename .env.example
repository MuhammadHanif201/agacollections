# ── Site ───────────────────────────────────────────────────────────────────
APP_NAME="AGA Collections"
# Public address of the store, no trailing slash (canonical URLs, emails, sitemap)
APP_URL=https://www.example.com
# Random secret of at least 32 characters (signs newsletter unsubscribe links)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string
# Optional: the Laravel APP_KEY ("base64:...") so unsubscribe links in emails already sent keep working
LEGACY_APP_KEY=
# Minutes a visitor session (bag, sign-in) lasts; 10080 = 7 days, as on the live site
SESSION_LIFETIME=10080

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tashan

# ── Media (Vercel Blob) ────────────────────────────────────────────────────
# Read/write token of the Blob store (used by the upload script and, later, the admin panel)
BLOB_READ_WRITE_TOKEN=
# Public base URL of the Blob store, printed by `npm run upload:media`
# (leave empty locally to serve files from public/storage)
NEXT_PUBLIC_MEDIA_BASE_URL=
# Optional: share image for social previews, e.g. logos/zayqora-share.jpg
SHARE_IMAGE_PATH=

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# MAIL_MAILER=log writes emails to the server log instead of sending them (local testing)
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls, ssl, or empty
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="AGA Collections"

# ── Analytics (leave empty to disable; use AGA Collections's own accounts) ──────────
META_PIXEL_ID=
CLARITY_ID=

# ── Storefront ─────────────────────────────────────────────────────────────
# Social profile icons link out only when true
SOCIAL_LINKS_ENABLED=false
# Affiliate links (account menu, checkout referral code) show only when true
AFFILIATE_LINKS_ENABLED=false
# Product card photo ratio, e.g. 1, 3/4 (default), 9/16
PRODUCT_CARD_IMAGE_RATIO=
